# Public URL, used for OG Image and production canonical
NUXT_PUBLIC_SITE_URL=https://majalengka.tech

# nuxt-auth-utils Session Encryption Key (minimal 32 karakter acak)
NUXT_SESSION_PASSWORD=majalengka_tech_session_secret_key_32chars_long

# GitHub OAuth App (buat di https://github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/github (lokal) atau https://majalengka.tech/api/auth/github (prod)
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Google OAuth 2.0 (buat di Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/google atau https://majalengka.tech/api/auth/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
