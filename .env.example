# Public URL, used for OG Image and production canonical
NUXT_PUBLIC_SITE_URL=https://majalengka.tech

# Better Auth Secret (minimal 32 karakter acak)
NUXT_BETTER_AUTH_SECRET=
BETTER_AUTH_SECRET=

# ID user (bukan email) yang selalu dianggap admin dan tidak bisa diturunkan, diblokir, atau dihapus.
# Pisahkan dengan koma. Lihat ID di halaman /kelola atau tabel `user`.
NUXT_SUPER_ADMIN_IDS=

# GitHub OAuth App (buat di https://github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/callback/github (lokal) atau https://majalengka.tech/api/auth/callback/github (prod)
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Google OAuth 2.0 (buat di Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google atau https://majalengka.tech/api/auth/callback/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Cloudinary Configuration (Dashboard Cloudinary -> Settings -> Access Keys)
NUXT_CLOUDINARY_CLOUD_NAME=
NUXT_CLOUDINARY_API_KEY=
NUXT_CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
